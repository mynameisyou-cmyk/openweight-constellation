{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openweight-constellation-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "observability": {
    "enabled": false
  }
}
